meta {
  name: Missing block identifier
  type: http
  seq: 12
}

get {
  url: {{host}}/eth/v1/beacon/blocks/root
}

tests {
  test("missing block identifiers return 400 without crashing the server", function () {
    expect(res.status).to.equal(400);
    expect(res.body).to.deep.equal({ code: 400, message: "invalid identifier" });
  });
}
