meta {
  name: State by root
  type: http
  seq: 7
}

get {
  url: {{host}}/eth/v1/beacon/states/{{state_root}}/root
}

tests {
  test("the returned state root resolves by identifier", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.root).to.equal(bru.getVar("state_root"));
  });
}
