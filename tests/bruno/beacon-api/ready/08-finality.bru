meta {
  name: Finality checkpoints
  type: http
  seq: 8
}

get {
  url: {{host}}/eth/v1/beacon/states/head/finality_checkpoints
}

tests {
  test("finality checkpoints have epoch and root fields", function () {
    expect(res.status).to.equal(200);
    expect(res.getHeader("content-type")).to.equal("application/json");
    for (const name of ["previous_justified", "current_justified", "finalized"]) {
      expect(res.body.data[name].epoch).to.match(/^\d+$/);
      expect(res.body.data[name].root).to.match(/^0x[0-9a-f]{64}$/);
    }
    expect(res.body.execution_optimistic).to.equal(false);
    expect(res.body.finalized).to.equal(true);
  });
}
