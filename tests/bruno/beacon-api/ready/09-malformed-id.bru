meta {
  name: Malformed block identifier
  type: http
  seq: 9
}

get {
  url: {{host}}/eth/v1/beacon/blocks/not-a-slot/root
}

tests {
  test("malformed identifiers return a Beacon API error", function () {
    expect(res.status).to.equal(400);
    expect(res.getHeader("content-type")).to.equal("application/json");
    expect(res.body).to.deep.equal({ code: 400, message: "invalid identifier" });
  });
}
