meta {
  name: Head block root
  type: http
  seq: 4
}

get {
  url: {{host}}/eth/v1/beacon/blocks/head/root
}

script:post-response {
  bru.setVar("block_root", res.body.data.root);
}

tests {
  test("head block root comes from the stored chain", function () {
    expect(res.status).to.equal(200);
    expect(res.getHeader("content-type")).to.equal("application/json");
    expect(res.body.data.root).to.match(/^0x[0-9a-f]{64}$/);
    expect(res.body.execution_optimistic).to.equal(false);
    expect(res.body.finalized).to.equal(true);
  });
}
