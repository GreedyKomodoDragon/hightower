meta {
  name: Health when unavailable
  type: http
  seq: 1
}

get {
  url: {{host}}/eth/v1/node/health
}

tests {
  test("health reports unavailable", function () {
    expect(res.status).to.equal(503);
    expect(res.getHeader("content-type")).to.equal("application/json");
    expect(res.body).to.deep.equal({ code: 503, message: "service unavailable" });
  });
}
